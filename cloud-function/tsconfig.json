{
  "compilerOptions": {
    "module": "NodeNext",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "outDir": "lib",
    "sourceMap": true,
    "strict": true,
    "target": "es2022",
    "resolveJsonModule": true,
    "moduleResolution": "nodenext",
    "lib": ["es2022"],
    "skipLibCheck": true
  },
  "compileOnSave": true,
  "include": ["src"],
  "jsonrpc": "2.0",
  "id": 1
}
