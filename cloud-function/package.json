    "deploy:requestSignature": "pnpm build && firebase deploy --only functions:requestSignature"
  },
  "engines": {
    "node": "20"
  },
  "type": "module",
  "main": "lib/index.js",
  "dependencies": {
    "@google-cloud/functions-framework": "^3.4.5",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node-forge": "^1.3.11",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^6.1.0",
    "form-data": "^4.0.1",
    "google-auth-library": "^9.15.0",
    "jsonwebtoken": "^9.0.2",
    "node-forge": "^1.3.1",
    "pnpm": "^9.14.1",
    "undici": "^6.21.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.1",
    "@types/node-fetch": "^2.6.12",
    "firebase-functions-test": "^3.3.0",
    "typescript": "^5.6.3"
  }
}